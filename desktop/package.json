    "description":  "Cute pastel streaming companion and OBS overlays for TikTok Live streamers",
    "main":  "main.js",
    "scripts":  {
                    "start":  "electron .",
                    "check":  "node -e \"require(\u0027./main.js\u0027)\"",
                    "package-update":  "powershell -ExecutionPolicy Bypass -File ./package-update.ps1",
                    "sync":  "powershell -ExecutionPolicy Bypass -File ./sync-app.ps1"
                },
    "keywords":  [
