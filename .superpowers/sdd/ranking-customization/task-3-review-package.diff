+
+  $('reset-toplikers-btn').addEventListener('click', () => {
+    demoLikersData.length = 0;
+    renderDemoTopLikersRows();
+  });
+  $('reset-toplikers-btn').trigger('click');
+  assert($('ov-demo-toplikers-rows').innerHTML.includes('No likers yet'));
+}
